 impl Matrix {
+    pub async fn split_fp16(&mut self) -> Result<(), TensorError> {
+        let Self::Fp16(matrix) = self else { return Ok(()); };
+        let shape = matrix.shape();
+        let limit = matrix.context().device.limits().max_storage_buffer_binding_size as usize;
+        if shape.len() * 2 <= limit { return Ok(()); }
+        let rows = (limit / (shape[0] * 2) / 8) * 8;
+        assert!(rows > 0 && shape[2] == 1 && shape[3] == 1);
+        let cpu = matrix.back().await;
+        let context = matrix.context().clone();
+        let mut chunks = Vec::new();
+        for start in (0..shape[1]).step_by(rows) {
+            let data = cpu.slice(.., start..(start + rows).min(shape[1]), .., ..)?;
+            chunks.push(data.to(&context));
+        }
+        *self = Self::Fp16Chunks(chunks);
+        Ok(())
+    }
+
+    fn chunks_op<F0: Float, F1: Float>(chunks: &[TensorGpu<f16, ReadWrite>], input: TensorGpuView<'_, F0>, output: TensorGpuView<'_, F1>, act: Activation, turbo: bool, sparse: bool) -> Result<TensorOp, TensorError> {
+        output.tensor().check_shape(output.shape())?;
+        let mut ops = Vec::new();
+        let mut start = 0;
+        for matrix in chunks {
+            let end = start + matrix.shape()[1];
+            let view = output.tensor().view(start..end, .., .., ..)?;
+            let op = if turbo {
+                TensorOp::matmul_mat_fp16(matrix, input.clone(), view, act)?
+            } else {
+                TensorOp::matmul_vec_fp16(matrix, input.clone(), view, act, sparse)?
+            };
+            ops.push(op);
+            start = end;
+        }
+        assert_eq!(start, output.shape()[0]);
+        Ok(TensorOp::List(ops))
+    }
+

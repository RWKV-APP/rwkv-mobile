+// Bound the prefill dispatch on devices whose output head needs split bindings.
+fn prefill_chunk_size(runtime: &WktvRuntime) -> usize {
+    if runtime.info.version == ModelVersion::V7
+        && runtime.info.head_buffer_size() > runtime.context.device.limits().max_storage_buffer_binding_size as usize
+    {
+        32
+    } else {
+        128
+    }
 }
 

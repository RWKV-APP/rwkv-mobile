# Restore only the reviewed CUDA source before applying the pinned patches.
function(rwkv_mobile_patch_llama_cpp_cublas_stream source_dir phase)
    if (NOT phase STREQUAL "restore" AND NOT phase STREQUAL "apply")
        message(FATAL_ERROR "Unknown cuBLAS patch phase")
    endif()
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/cublas-stream-plan.json" plan)
    string(JSON length LENGTH "${plan}" files)
    math(EXPR last "${length} - 1")
    foreach(i RANGE 0 ${last})
        string(JSON name GET "${plan}" files ${i} file)
        string(JSON before GET "${plan}" files ${i} beforeSha256)
        string(JSON after GET "${plan}" files ${i} afterSha256)
        file(READ "${source_dir}/${name}" original_${i})
        string(REPLACE "\r\n" "\n" text "${original_${i}}")
        string(SHA256 actual "${text}")
        string(JSON upstream ERROR_VARIABLE upstream_missing GET "${plan}" files ${i} upstreamSha256)
        if (phase STREQUAL "restore" AND NOT upstream_missing AND actual STREQUAL upstream)
            # The canonical CUDA patches transform the exact pinned upstream file next.
            set(expected "${upstream}")
        elseif (actual STREQUAL before OR actual STREQUAL after)
            if (phase STREQUAL "restore")
                set(expected "${before}")
            else()
                set(expected "${after}")
            endif()
        else()
            message(FATAL_ERROR "Unreviewed cuBLAS stream source: ${name}")
        endif()
        if (NOT actual STREQUAL expected)
            string(JSON edits LENGTH "${plan}" files ${i} edits)
            math(EXPR edit_last "${edits} - 1")
            foreach(order RANGE 0 ${edit_last})
                if (phase STREQUAL "restore")
                    math(EXPR j "${edit_last} - ${order}")
                    set(a to)
                    set(b from)
                else()
                    set(j ${order})
                    set(a from)
                    set(b to)
                endif()
                string(JSON from GET "${plan}" files ${i} edits ${j} ${a})
                string(JSON to GET "${plan}" files ${i} edits ${j} ${b})
                string(JSON count GET "${plan}" files ${i} edits ${j} count)
                string(LENGTH "${text}" old_length)
                string(LENGTH "${from}" marker_length)
                string(REPLACE "${from}" "" shortened "${text}")
                string(LENGTH "${shortened}" new_length)
                math(EXPR removed "${old_length} - ${new_length}")
                math(EXPR wanted "${marker_length} * ${count}")
                if (marker_length EQUAL 0 OR NOT removed EQUAL wanted)
                    message(FATAL_ERROR "cuBLAS stream marker count changed: ${name}/${j}")
                endif()
                string(REPLACE "${from}" "${to}" text "${text}")
            endforeach()
        endif()
        string(SHA256 patched "${text}")
        if (NOT patched STREQUAL expected)
            message(FATAL_ERROR "cuBLAS stream patch digest changed: ${name}")
        endif()
        file(READ "${source_dir}/${name}" line_endings HEX)
        string(FIND "${line_endings}" "0d0a" crlf)
        if (crlf EQUAL -1)
            set(newline_${i} LF)
        else()
            set(newline_${i} CRLF)
        endif()
        set(expected_${i} "${expected}")
        set(patched_${i} "${text}")
        set(file_${i} "${source_dir}/${name}")
    endforeach()
    foreach(i RANGE 0 ${last})
        if (NOT original_${i} STREQUAL patched_${i})
            file(CONFIGURE OUTPUT "${file_${i}}" CONTENT "${patched_${i}}" @ONLY NEWLINE_STYLE ${newline_${i}})
            file(READ "${file_${i}}" written)
            string(REPLACE "\r\n" "\n" written "${written}")
            string(SHA256 written_hash "${written}")
            file(READ "${file_${i}}" written_hex HEX)
            string(FIND "${written_hex}" "0d0d0a" double_cr)
            if (NOT written_hash STREQUAL expected_${i} OR NOT double_cr EQUAL -1)
                message(FATAL_ERROR "cuBLAS source bytes differ after write: ${file_${i}}")
            endif()
        endif()
    endforeach()
endfunction()
